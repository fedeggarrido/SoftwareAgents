{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "baseCommit",
    "fixCommit",
    "brief",
    "timeoutMin",
    "allowedPaths",
    "criteria"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "not": { "const": "all" } },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "fixCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "brief": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "timeoutMin": { "type": "integer", "minimum": 1, "maximum": 10 },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*$"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "testName"],
        "properties": {
          "file": { "type": "string", "pattern": "^server/__tests__/[a-zA-Z0-9-]+\\.test\\.ts$" },
          "testName": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
