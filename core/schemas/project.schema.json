{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "softwareagents.io/v1alpha1"
    },
    "kind": {
      "const": "Project"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "remote",
        "defaultBranch"
      ]
    },
    "brain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ]
    },
    "clickup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "folderId": {
          "type": "string",
          "minLength": 1
        },
        "listIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "workspaceId",
        "folderId",
        "listIds"
      ]
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boardFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "boardFile"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "name",
    "repo",
    "brain"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
