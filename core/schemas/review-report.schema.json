{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": { "enum": ["approve", "request_changes"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "summary", "suggestion"],
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "suggestion": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "acCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac", "status"],
        "properties": {
          "ac": { "type": "string", "minLength": 1 },
          "status": { "enum": ["covered", "missing", "partial"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "request_changes" } } },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["severity"],
              "properties": { "severity": { "enum": ["blocker", "major"] } }
            }
          }
        }
      }
    }
  ]
}
