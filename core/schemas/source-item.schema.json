{
  "type": "object", "additionalProperties": false,
  "required": ["id", "adapter", "title", "retrievedAt", "kind", "excerpt", "language", "contentHash"],
  "anyOf": [{"required": ["url"], "properties": {"url": {}}}, {"required": ["citation"], "properties": {"citation": {}}}],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 100},
    "url": {"type": "string", "pattern": "^https?://", "maxLength": 4096},
    "citation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "author": {"type": "string", "minLength": 1, "maxLength": 500},
    "channel": {"type": "string", "minLength": 1, "maxLength": 500},
    "publishedAt": {"type": "string", "maxLength": 40},
    "retrievedAt": {"type": "string", "maxLength": 40},
    "kind": {"enum": ["video", "thread", "book", "article", "paper", "podcast", "web"]},
    "excerpt": {"type": "string", "maxLength": 4000},
    "signals": {"type": "object", "additionalProperties": false, "properties": {
      "votes": {"type": "number"}, "views": {"type": "number", "minimum": 0}, "citations": {"type": "number", "minimum": 0}, "authorReputation": {"type": "number"}
    }},
    "language": {"type": "string", "minLength": 1, "maxLength": 100},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
