{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "softwareagents.io/v1alpha1"
    },
    "kind": {
      "const": "TaskDAG"
    },
    "feature": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3}$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/definitions/taskKey"
          },
          "type": {
            "enum": ["spec", "design", "code", "review", "qa", "doc", "spike"]
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "description": {
            "$ref": "#/definitions/text"
          },
          "acceptanceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/taskKey"
            },
            "uniqueItems": true
          },
          "agentRole": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "size": {
            "enum": ["S", "M", "L"]
          }
        },
        "required": [
          "key",
          "type",
          "title",
          "description",
          "acceptanceRefs",
          "dependsOn",
          "agentRole",
          "size"
        ]
      }
    }
  },
  "required": ["apiVersion", "kind", "feature", "tasks"],
  "definitions": {
    "taskKey": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3}-T[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Shape only. Graph rules (unique keys, existing dependencies, no cycles, acceptance coverage) are checked by server/src/taskDag.ts. agentRole names an AgentSpec metadata.id and grants no authority."
}
