{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "softwareagents.io/v1alpha1"
    },
    "kind": {
      "const": "TechnicalDesign"
    },
    "feature": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "status": {
      "enum": ["draft", "proposed", "approved", "superseded"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/text"
      },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      },
      "uniqueItems": true
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      },
      "uniqueItems": true
    }
  },
  "required": ["apiVersion", "kind", "feature", "version", "status", "components", "risks", "adrs"],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Front matter of a TechnicalDesign .md in the Project Brain. Declarative only; ADR identifiers are references, never authority or automatic fetch targets."
}
